# The local control plane (`nix run`, `pnpm e2e`). Copy to .env.local and fill in.

# Required.
SANCHORIS_BIND_ADDR=127.0.0.1:8080
SANCHORIS_FRONTEND_DIR=apps/frontend/dist
SANCHORIS_TABLE_MAIN=main
SANCHORIS_TABLE_AUDIT=audit
# At least 32 bytes: signs the tokens of the Thread channel and the local presigned URLs.
THREAD_TOKEN_SIGNING_KEY=
# 32 bytes in base64: seals the secrets of Credentials (AES-256-GCM).
SANCHORIS_CREDENTIAL_KEY=
# The one User of the local server, on the Admin Plan.
SANCHORIS_LOCAL_USER=local
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_ENDPOINT_URL_DYNAMODB=http://127.0.0.1:8000
AWS_ENDPOINT_URL_DYNAMODB_STREAMS=http://127.0.0.1:8000

# Optional.
# The URL the Workspaces reach the server at (default http://<SANCHORIS_BIND_ADDR>).
SANCHORIS_PUBLIC_URL=
# A configuration repository on disk (sanchoris.yaml and skills/), activated at the start.
SANCHORIS_LOCAL_CONFIG_DIR=
# Credentials as JSON: {"<name>": {"provider": "claude", "kind": "claude_oauth_token", "value": "..." | "valueFile": "<path>"}}.
SANCHORIS_LOCAL_CREDENTIALS=
# Bare repositories at <root>/github.com/<owner>/<name>, which stand in for GitHub.
SANCHORIS_LOCAL_GIT_ROOT=
# Where the local Workspaces run, and the command of sanchoris-agent (`run` is added).
SANCHORIS_LOCAL_WORKSPACES_DIR=
SANCHORIS_AGENT_COMMAND=node apps/sanchoris-agent/src/main.ts
# Passed to sanchoris-agent: the clone URL prefix of the repositories, and a Worker module.
SANCHORIS_GIT_URL_PREFIX=
SANCHORIS_WORKER_MODULE=
SANCHORIS_CLAUDE_PATH=
SANCHORIS_CODEX_PATH=
# Any value traces the stream records and the jobs of the local control plane.
SANCHORIS_DEBUG=
